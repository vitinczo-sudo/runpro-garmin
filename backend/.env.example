PORT=8787
FRONTEND_ORIGIN=http://localhost:4173
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
APP_BASE_URL=http://localhost:8787
APP_PUBLIC_URL=http://localhost:8787

# Garmin Connect Developer Program credentials
GARMIN_CLIENT_ID=your_client_id
GARMIN_CLIENT_SECRET=your_client_secret

# OAuth2 PKCE endpoints (set these to the values from your Garmin project docs)
GARMIN_OAUTH_AUTHORIZE_URL=https://apis.garmin.com/tools/oauth2/authorizeUser
GARMIN_OAUTH_TOKEN_URL=https://apis.garmin.com/tools/oauth2/token
GARMIN_OAUTH_SCOPE=activity_export workout_import

# API endpoints for your approved Garmin project
GARMIN_ACTIVITY_PULL_URL=
GARMIN_TRAINING_PUSH_URL=

# Optional: simple shared secret for incoming webhook calls to this server
GARMIN_WEBHOOK_TOKEN=
